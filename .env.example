# Application
APP_NAME=AI for Audit
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# TASK-102 local persistence
DATABASE_PATH=data/audit.sqlite3
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.xlsx,.csv

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Future integrations: keep real values only in .env, never commit them.
# LLM_API_KEY=
